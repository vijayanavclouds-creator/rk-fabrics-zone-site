datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String
  detailsHtml      String?  @db.Text
  shortDescription String
  category         String
  subcategory      String?
  subSubcategory   String?
  gender           String
  type             String
  basePrice        Float
  salePrice        Float?
  discountPercent  Int      @default(0)
  isOnSale         Boolean  @default(false)
  isFreeDelivery   Boolean  @default(true)
  fabric           String
  fabricDetails    String?
  occasion         String[]
  tags             String[]
  rating           Float
  reviewCount      Int
  isFeatured       Boolean  @default(false)
  isNewArrival     Boolean  @default(false)
  isBestseller     Boolean  @default(false)
  isActive         Boolean  @default(true)
  isReturnable     Boolean  @default(true)
  createdAt        DateTime @default(now())

  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]
}

model ProductVariant {
  id        String @id @default(cuid())
  sku       String @unique
  size      String
  color     String
  colorHex  String
  price     Float
  salePrice Float?
  stock     Int

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String
  isPrimary Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  userName  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
}

model Banner {
  id        String   @id @default(cuid())
  type      String // "hero" or "carousel"
  imageUrl  String
  title     String?
  subtitle  String?
  link      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// NextAuth Models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  phone              String?
  dob                String?
  password           String?
  role               String    @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  receiveOrderEmails Boolean   @default(true)

  accounts          Account[]
  sessions          Session[]
  orders            Order[]
  addresses         Address[]
  wishlistItems     WishlistItem[]
  coupons           Coupon[]
  notifications     Notification[]
  queries           ContactQuery[]
  newsletters       UserNewsletter[]
  reviews           Review[]
  returnRequests    ReturnRequest[]
  pushSubscriptions PushSubscription[]
  cartData          String? // JSON string of the cart
  cartUpdatedAt     DateTime?
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  type      String // SIGNUP, REACTIVATE, RESET_PASSWORD
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Coupon {
  id                String   @id @default(cuid())
  code              String   @unique
  discountValue     Float
  discountType      String // "PERCENTAGE" or "FIXED"
  validForUserId    String?
  user              User?    @relation(fields: [validForUserId], references: [id], onDelete: Cascade)
  isUsed            Boolean  @default(false)
  isActive          Boolean  @default(true)
  isForNewUsersOnly Boolean  @default(false)
  expiresAt         DateTime
  createdAt         DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String // e.g. "ORDER", "REVIEW", "QUERY", "SYSTEM"
  message   String
  link      String? // Optional link to redirect when clicked
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminActivity {
  id        String   @id @default(cuid())
  adminName String   @default("System")
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

model AdminSettings {
  id                         String   @id @default("singleton")
  lateShippingThresholdHours Int      @default(6)
  expressShippingFee         Float    @default(150)
  updatedAt                  DateTime @updatedAt
}

model Order {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String    @default("CONFIRMED") // CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  totalAmount        Float
  shippingAmount     Float
  platformFeeAmount  Float     @default(0)
  gstAmount          Float     @default(0)
  subtotalAmount     Float
  discountAmount     Float     @default(0)
  couponCode         String?
  shippingAddress    String
  phone              String
  email              String
  paymentMethod      String    @default("COD")
  paymentStatus      String    @default("PENDING") // PENDING, PAID, FAILED
  transactionId      String?
  transactionDetails String?   @db.Text
  isReadByAdmin      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  shippedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?

  // Shipping Integration
  awbNumber        String?
  shippingProvider String  @default("BLUEDART") // Legacy, but using DELHIVERY now
  shippingMode     String  @default("Surface") // "Surface" or "Express"
  waybillGenerated Boolean @default(false)

  items         OrderItem[]
  returnRequest ReturnRequest?
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  variantId    String
  productName  String
  variantName  String
  quantity     Int
  price        Float
  image        String?
  isReturnable Boolean @default(true)
  review       Review?
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // Stored as JSON string
  updatedAt DateTime @updatedAt
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String
  address   String
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactQuery {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String?
  subject      String
  orderId      String? // Optional relation to an order for returns
  status       String   @default("OPEN") // OPEN, RESOLVED
  isRead       Boolean  @default(false)
  isReadByUser Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages QueryMessage[]
}

model QueryMessage {
  id         String       @id @default(cuid())
  queryId    String
  query      ContactQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  senderType String // CUSTOMER or ADMIN
  message    String
  attachment String?
  createdAt  DateTime     @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Newsletter {
  id          String   @id @default(cuid())
  subject     String
  content     String
  couponCode  String?
  targetUsers String?
  createdAt   DateTime @default(now())

  recipients UserNewsletter[]
}

model UserNewsletter {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsletterId String
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  isRead       Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([userId, newsletterId])
}

model ReturnRequest {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         String[] // Array of order item IDs returned
  reasons       String[] // e.g. "Size Issue", "Defective Product"
  description   String? // custom description if "Other"
  refundMethod  String // e.g. "UPI", "BANK_TRANSFER", "STORE_CREDIT", "ORIGINAL_METHOD"
  refundDetails String? // Stores UPI ID or Bank details
  status        String   @default("PENDING") // PENDING, RETURNED, RETURN_REJECTED
  isReadByAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HtmlRecord {
  id        String   @id @default(cuid())
  title     String
  type      String // "HERO" or "CAROUSEL"
  code      String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
